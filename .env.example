# Copy this file to `.env` (which is gitignored and never committed) and fill in
# whichever provider you're using. Nothing here is read unless you create `.env`.
#
# You do NOT need to paste a key into chat. See README.md → "Supplying the Fal
# key" for the three places you can put it instead.

# Fal.ai — format is <key-id>:<key-secret>
FAL_KEY=

# Google Gemini (alternative image provider; GOOGLE_API_KEY also works)
GEMINI_API_KEY=
